# Backend Database Configuration
# For PostgreSQL production: postgresql://user:password@host:5432/dbname
# For development SQLite: sqlite:///./dev.db (default)
DATABASE_URL=sqlite:///./dev.db

# Security - MUST be changed for production deployment
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production

# CORS - Frontend URL for cross-origin requests
# For local development: http://localhost:3000
# For production: https://yourfrontend.com
FRONTEND_URL=http://localhost:3000

# File Upload Settings
UPLOAD_DIR=storage/documents
MAX_UPLOAD_SIZE_MB=10

# RAG Retrieval Settings
DEFAULT_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.0

# Embedding Provider Configuration (local Ollama)
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Verified nomic-embed-text output dimension; must match the pgvector migration.
EMBEDDING_DIM=768

# LLM Provider Configuration (Optional - required for chat endpoint)
# Local generation model (separate from the embedding model)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b

# PostgreSQL Docker Service Configuration
# Used by docker-compose for Postgres database initialization
POSTGRES_PASSWORD=postgres

# Frontend Configuration
# Backend API URL for production
# For local development: http://localhost:8000 (relative paths work)
# For production: https://api.example.com
VITE_API_URL=http://localhost:8000

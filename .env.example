# Embedding provider: 'fake' | 'openai'
EMBEDDING_PROVIDER=fake
# Embedding model name when using an API provider
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Embedding dimension (override if needed)
EMBEDDING_DIM=384

# If using OpenAI provider, set your API key (do NOT commit your real key)
OPENAI_API_KEY=

# Database URL. For pgvector integration use a Postgres URL, e.g.:
# postgresql://user:pass@localhost:5432/dbname
DATABASE_URL=sqlite:///./dev.db

# Backend Database Configuration
# For PostgreSQL production: postgresql://user:password@host:5432/dbname
# For development SQLite: sqlite:///./dev.db (default)
DATABASE_URL=sqlite:///./dev.db

# Security - MUST be changed for production deployment
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production

# CORS - Frontend URL for cross-origin requests
# For local development: http://localhost:3000
# For production: https://yourfrontend.com
FRONTEND_URL=http://localhost:3000

# File Upload Settings
UPLOAD_DIR=storage/documents
MAX_UPLOAD_SIZE_MB=10

# RAG Retrieval Settings
DEFAULT_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.0

# Embedding Provider Configuration
# DEVELOPMENT ONLY: 'fake' provides deterministic, dimension-mismatch embeddings for testing
# PRODUCTION: Use 'openai' with real OpenAI API credentials
EMBEDDING_PROVIDER=fake
# For OpenAI: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Dimension must match model output: fake=8, ada-002=1536, 3-small=1536, 3-large=3072
EMBEDDING_DIM=384

# For production with OpenAI embeddings, set your API key (do NOT commit real keys)
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# LLM Provider Configuration (Optional - required for chat endpoint)
# DEVELOPMENT ONLY: 'fake' provides stub responses for testing
# PRODUCTION: Use 'openai' with real OpenAI API credentials
LLM_PROVIDER=fake
# For OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo, etc.
LLM_MODEL=gpt-3.5-turbo

# PostgreSQL Docker Service Configuration
# Used by docker-compose for Postgres database initialization
POSTGRES_PASSWORD=postgres

# Frontend Configuration
# Backend API URL for production
# For local development: http://localhost:8000 (relative paths work)
# For production: https://api.example.com
VITE_API_URL=http://localhost:8000
